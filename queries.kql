// Sentinel SOC Lab KQL library
// Sentinel Logs tables use TimeGenerated. Defender Advanced hunting (Device*) tables use Timestamp.
// Run Device* queries in Defender portal > Investigation & response > Hunting > Advanced hunting (KQL mode).

// ============================================================
// WEEK 1: Data health and detections
// ============================================================

// --- Agent heartbeat ---
Heartbeat
| summarize LastSeen = max(TimeGenerated) by Computer

// --- Ingestion volume by table ---
Usage
| where TimeGenerated > ago(1d)
| summarize GB = sum(Quantity) / 1000 by DataType
| order by GB desc

// --- Failed logons (rule 1 logic) ---
SecurityEvent
| where EventID == 4625
| summarize Failures = count(), Accounts = dcount(TargetUserName)
    by IpAddress, Computer, bin(TimeGenerated, 10m)
| where Failures >= 5

// --- Failed logons by account (analytics rule query) ---
SecurityEvent
| where EventID == 4625
| summarize Failures = count() by TargetUserName, Computer
| where Failures >= 5

// --- New local admin (rule 2 logic, tuned to include member fields) ---
SecurityEvent
| where EventID == 4720 or (EventID == 4732 and TargetUserName == "Administrators")
| project TimeGenerated, Computer, EventID, Activity, TargetUserName, SubjectUserName, MemberName, MemberSid

// --- Trace the created account by SID (4720 TargetSid should equal 4732 MemberSid) ---
SecurityEvent
| where EventID in (4720, 4732)
| project TimeGenerated, EventID, Activity, TargetUserName, TargetSid, SubjectUserName, MemberName, MemberSid
| order by TimeGenerated desc

// --- SID join: which account was added to Administrators, and by whom ---
let created = SecurityEvent
    | where EventID == 4720
    | project NewAccount = TargetUserName, Sid = TargetSid;
SecurityEvent
| where EventID == 4732 and TargetUserName == "Administrators"
| project AddedTime = TimeGenerated, Computer, ActedBy = SubjectUserName, Sid = MemberSid
| join kind=inner created on Sid
| project AddedTime, Computer, ActedBy, NewAccount, Sid

// ============================================================
// WEEK 2: Defender data and incident investigation
// ============================================================

// --- Device in group? (Advanced hunting) ---
DeviceInfo
| where Timestamp > ago(1d)
| summarize arg_max(Timestamp, *) by DeviceName
| project DeviceName, MachineGroup, OnboardingStatus, OSPlatform

// --- Incident to alert mapping (Sentinel Logs) ---
SecurityIncident
| where TimeGenerated > ago(7d)
| summarize arg_max(TimeGenerated, *) by IncidentNumber
| mv-expand AlertId = AlertIds to typeof(string)
| join kind=inner (SecurityAlert | summarize arg_max(TimeGenerated, *) by SystemAlertId)
    on $left.AlertId == $right.SystemAlertId
| project IncidentNumber, Title, AlertName, AlertSeverity, Tactics, Status

// --- Fallback process telemetry if Device tables are empty (needs 4688 auditing with command line) ---
SecurityEvent
| where EventID == 4688
| project TimeGenerated, Computer, Account, NewProcessName, CommandLine
| order by TimeGenerated desc

// --- Recent process events (Advanced hunting) ---
DeviceProcessEvents
| where Timestamp > ago(1h)
| project Timestamp, DeviceName, FileName, ProcessCommandLine, AccountName
| order by Timestamp desc
| take 20

// --- Encoded PowerShell (T1059.001) ---
DeviceProcessEvents
| where Timestamp > ago(1d)
| where FileName =~ "powershell.exe" and ProcessCommandLine has_any ("-enc", "-EncodedCommand")
| extend b64 = extract(@"(?i)-e(?:nc|ncodedcommand)?\s+([A-Za-z0-9+/=]+)", 1, ProcessCommandLine)
| extend decoded = base64_decode_tostring(b64)   // may look spaced out: PowerShell uses UTF-16
| project Timestamp, DeviceName, AccountName, InitiatingProcessFileName, decoded

// --- Run key persistence (T1547.001) ---
DeviceRegistryEvents
| where Timestamp > ago(1d)
| where RegistryKey has @"CurrentVersion\Run" and ActionType == "RegistryValueSet"
| project Timestamp, DeviceName, RegistryKey, RegistryValueName, RegistryValueData, InitiatingProcessCommandLine

// --- LSASS access attempt (T1003.001) ---
DeviceProcessEvents
| where ProcessCommandLine has_any ("comsvcs.dll", "MiniDump") or FileName =~ "procdump.exe"

// --- Defender alerts from the endpoint ---
SecurityAlert
| where ProductName has "Defender for Endpoint"
| project TimeGenerated, AlertName, AlertSeverity, Tactics, Entities

// ============================================================
// WEEK 3: Threat hunting (hunt first, then compare with alerts)
// ============================================================

// --- Scheduled task creation (T1053.005) ---
DeviceProcessEvents
| where FileName =~ "schtasks.exe" and ProcessCommandLine has "/create"

// --- certutil download (T1105) ---
DeviceProcessEvents
| where FileName =~ "certutil.exe" and ProcessCommandLine has_any ("urlcache", "-split", "-decode")

// --- Event log cleared (T1070.001) ---
SecurityEvent
| where EventID == 1102

// --- LOLBins talking to the internet ---
let lolbins = dynamic(["rundll32.exe","mshta.exe","regsvr32.exe","certutil.exe","bitsadmin.exe"]);
DeviceNetworkEvents
| where InitiatingProcessFileName in~ (lolbins) and RemoteIPType == "Public"
| project Timestamp, DeviceName, InitiatingProcessFileName, InitiatingProcessCommandLine, RemoteIP, RemoteUrl

// --- Defender tamper attempts (T1562.001) ---
DeviceProcessEvents
| where ProcessCommandLine has_any ("Set-MpPreference", "DisableRealtimeMonitoring")

// --- Rare parent-child process pairs ---
DeviceProcessEvents
| where Timestamp > ago(14d)
| summarize Count = count() by InitiatingProcessFileName, FileName
| where Count < 5
| order by Count asc

// --- Kill-chain timeline for one device (edit DeviceName) ---
union withsource=Table DeviceProcessEvents, DeviceRegistryEvents, DeviceNetworkEvents, DeviceFileEvents
| where DeviceName startswith "sc200-ws22" and Timestamp > ago(1d)
| project Timestamp, Table, ActionType, FileName, ProcessCommandLine, RegistryKey, RemoteUrl
| order by Timestamp asc

// --- Watchlist exclusion pattern (watchlist alias: ApprovedAdmins, column: Account) ---
let approved = _GetWatchlist('ApprovedAdmins') | project Account = tostring(SearchKey);
SecurityEvent
| where EventID == 4720 or (EventID == 4732 and TargetUserName == "Administrators")
| where SubjectUserName !in (approved)
| project TimeGenerated, Computer, EventID, Activity, TargetUserName, SubjectUserName, MemberName, MemberSid

// --- Summary rule source: hourly 4625 counts ---
SecurityEvent
| where EventID == 4625
| summarize FailedLogons = count() by Computer, TargetUserName, bin(TimeGenerated, 1h)
